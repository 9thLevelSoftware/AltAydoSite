# Example environment configuration
# Copy this file to .env.local and update with your actual values

# MongoDB connection - use ONE of these options:
# Option 1: Regular CosmosDB MongoDB connection string
# MONGODB_URI=mongodb://username:password@aydocorpdb.documents.azure.com:10255/?ssl=true&replicaSet=globaldb

# Option 2: CosmosDB vCore MongoDB connection string
COSMOSDB_CONNECTION_STRING=mongodb+srv://username:password@aydocorpdb-vcore.global.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000

# CosmosDB configuration
COSMOS_DATABASE_ID=aydocorp-database
COSMOS_CONTAINER_ID=users

# Other app settings can be added here

# Ship sync configuration
SHIP_SYNC_MAX_CHANGED_SHIPS_PER_RUN=75
SHIP_SYNC_LOCK_TTL_MS=7200000
SHIP_SYNC_IN_PROCESS_CRON_ENABLED=false
# Only used if the backup in-app cron is explicitly enabled.
SHIP_SYNC_CRON_SCHEDULE=0 0 */2 * *
# CRON_SECRET is reused for ship-sync endpoint auth (already exists if Discord sync is configured)

# Cloudflare R2 ship image mirroring
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_URL=https://images.aydocorp.space
# Defaults to "images" when omitted.
CLOUDFLARE_R2_BUCKET_NAME=images
# Defaults to "ships" when omitted.
CLOUDFLARE_R2_SHIP_IMAGE_PREFIX=ships
