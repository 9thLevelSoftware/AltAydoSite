# NextAuth.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key

# Azure Cosmos DB Configuration
COSMOS_ENDPOINT=your-cosmos-endpoint
COSMOS_KEY=your-cosmos-key
COSMOS_DATABASE_ID=your-database-id
COSMOS_CONTAINER_ID=your-container-id

# Microsoft Entra ID (Azure AD) Configuration
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret

# Discord Integration Configuration
# To enable Discord scheduled events sync:
# 1. Create a Discord Application at https://discord.com/developers/applications
# 2. Create a bot and copy the bot token
# 3. Get your Discord server (guild) ID
# 4. Invite the bot to your server with the "View Guild Events" permission
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-discord-server-id 

# Protected cron endpoints
CRON_SECRET=your-cron-secret

# FleetYards ship sync and Cloudflare R2 image mirroring
SHIP_SYNC_MAX_CHANGED_SHIPS_PER_RUN=75
SHIP_SYNC_LOCK_TTL_MS=7200000
SHIP_SYNC_IN_PROCESS_CRON_ENABLED=false
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_URL=https://images.aydocorp.space
CLOUDFLARE_R2_BUCKET_NAME=images
CLOUDFLARE_R2_SHIP_IMAGE_PREFIX=ships
