{
  "name": "aydocorp-website",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    ">0.3%",
    "not dead",
    "not op_mini all"
  ],
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next",
    "kill-port": "node scripts/kill-port.js",
    "migrate-timezone": "tsx src/scripts/migrate-timezone.ts",
    "migrate-ships": "cross-env DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config src/scripts/migrate-ship-references.ts",
    "sync-ships": "cross-env DOTENV_CONFIG_PATH=.env.local tsx -r dotenv/config src/scripts/sync-ships.ts",
    "test-cosmos": "tsx src/scripts/test-cosmos-connection.ts",
    "test-mongo": "tsx src/scripts/test-mongodb-connection.ts",
    "gen-mongo-connection": "tsx src/scripts/cosmos-connection-string.ts",
    "verify-cosmos": "tsx src/scripts/verify-cosmos.ts",
    "verify-email": "tsx src/scripts/verify-email-config.ts",
    "gen-password": "tsx src/scripts/generate-password.ts",
    "start-discord-monitor": "node scripts/start-discord-monitor.js",
    "assign-synced-role": "tsx src/scripts/assign-synced-role.ts",
    "analyze": "cross-env ANALYZE=true next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18 <=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1055.0",
    "@heroicons/react": "^2.1.1",
    "axios": "^1.6.7",
    "bcrypt": "^5.1.1",
    "discord.js": "^14.22.1",
    "dotenv": "^16.5.0",
    "file-type": "^21.3.0",
    "mongodb": "^6.16.0",
    "motion": "^12.34.0",
    "next": "^15.5.12",
    "next-auth": "^4.24.11",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.7.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.3.0",
    "zod": "^3.24.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.10",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.7",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.12",
    "fs-extra": "^11.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8",
    "postcss-preset-env": "^10.1.6",
    "prettier": "^3.8.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  }
}
